<?xml version="1.0" encoding="utf-8"?>
<!-- ==================== 颜色定义（MD2 深色模式 省电） ==================== -->
<resources>
    <!-- 主色：靛蓝 (Indigo 500) -->
    <color name="primary">#3F51B5</color>
    <color name="primary_dark">#303F9F</color>
    <color name="primary_light">#7986CB</color>

    <!-- 强调色：青色 (Teal 500) -->
    <color name="accent">#009688</color>

    <!-- 背景：纯黑（OLED省电） -->
    <color name="background">#000000</color>
    <!-- 卡片：深灰 -->
    <color name="surface">#1E1E1E</color>
    <color name="surface_variant">#2B2B2B</color>
    <color name="surface_light">#333333</color>

    <!-- 文字：白色 + 灰色 -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B0B0B0</color>
    <color name="text_hint">#757575</color>

    <!-- 分隔线 -->
    <color name="divider">#333333</color>
    <color name="border">#444444</color>

    <!-- 状态颜色 -->
    <color name="online">#4CAF50</color>
    <color name="offline">#9E9E9E</color>
    <color name="error">#F44336</color>
    <color name="warning">#FF9800</color>
    <color name="success">#4CAF50</color>
    <color name="unread_dot">#E91E63</color>

    <!-- 气泡 -->
    <color name="bubble_me">#3F51B5</color>
    <color name="bubble_other">#2B2B2B</color>
    <color name="bubble_me_text">#FFFFFF</color>
    <color name="bubble_other_text">#FFFFFF</color>
</resources>
